DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
SENTINEL_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false
# Allow monitoring private/local URLs (localhost, 192.168.x.x, etc.).
# Set true ONLY for local development. Keep false (the default) in production.
SENTINEL_ALLOW_PRIVATE_API_TARGETS=true
API_SENTINEL_KEY=
SENTINEL_COLLECTOR_URL=http://127.0.0.1:8000/api/telemetry/batch
SENTINEL_REGION=local
REDIS_URL=redis://127.0.0.1:6379/0
